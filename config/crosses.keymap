#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    behaviors {
        // Auto-shift: only used on the raise symbol/number layer (tap = number,
        // hold = symbol). Not used on the alpha layers, where home-row mods live.
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Home-row mods (GACS). Positional: a mod only triggers when the next
        // key is on the OPPOSITE hand, preventing same-hand rolls from firing
        // mods. Timing is the urob/timeless style.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
    };

    macros {
        // U.S. International PC: " (dead key) + vowel = umlaut; AltGr+s = ß
        de_ae: de_ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp A>;
        };
        de_oe: de_oe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp O>;
        };
        de_ue: de_ue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp U>;
        };
        de_ss: de_ss {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(S)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // ä = A + neighbour (same positions on QWERTY and Colemak)
        combo_ae {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&de_ae>;
            layers = <0 4>;
        };

        // QWERTY (layer 0)
        combo_oe_q {
            timeout-ms = <50>;
            key-positions = <7 8>;    // I + O
            bindings = <&de_oe>;
            layers = <0>;
        };
        combo_ue_q {
            timeout-ms = <50>;
            key-positions = <5 6>;    // Y + U
            bindings = <&de_ue>;
            layers = <0>;
        };
        combo_ss_q {
            timeout-ms = <50>;
            key-positions = <11 12>;  // S + D
            bindings = <&de_ss>;
            layers = <0>;
        };

        // Colemak (layer 4)
        combo_oe_c {
            timeout-ms = <50>;
            key-positions = <18 19>;  // I + O
            bindings = <&de_oe>;
            layers = <4>;
        };
        combo_ue_c {
            timeout-ms = <50>;
            key-positions = <7 8>;    // U + Y
            bindings = <&de_ue>;
            layers = <4>;
        };
        combo_ss_c {
            timeout-ms = <50>;
            key-positions = <12 13>;  // S + T
            bindings = <&de_ss>;
            layers = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q          &kp W          &kp E           &kp R          &kp T        &kp Y     &kp U          &kp I          &kp O          &kp P
&hml LGUI A    &hml LALT S    &hml LCTRL D    &hml LSHFT F   &kp G        &kp H     &hmr RSHFT J   &hmr RCTRL K   &hmr RALT L    &hmr RGUI SQT
&kp Z          &kp X          &kp C           &kp V          &kp B        &kp N     &kp M          &kp RCTRL      &kp RALT       &kp DOT
                              &lt 3 LEFT_GUI  &mo 1          &kp SPACE    &kp RET   &mo 2          &kp BSPC
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT     &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp LEFT   &kp DOWN  &kp UP           &kp RIGHT  &trans
&bt BT_CLR    &trans        &trans        &trans        &trans        &trans     &trans    &trans           &to 4      &to 0
                            &kp LGUI      &trans        &kp SPACE     &kp RET    &kp ESC   &kp TAB
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&as N1 EXCL      &as N2 AT       &as N3 HASH  &as N4 DOLLAR        &as N5 PERCENT  &as N6 CARET  &as N7 AMPS           &as N8 ASTRK  &as N9 LEFT_PARENTHESIS  &as N0 RIGHT_PARENTHESIS
&as MINUS UNDER  &as EQUAL PLUS  &kp LBRC     &kp LBKT             &kp LPAR        &kp RPAR      &kp RBKT              &kp RBRC      &as FSLH QUESTION        &as BSLH PIPE
&as GRAVE TILDE  &trans          &trans       &as COMMA LESS_THAN  &kp COLON       &kp SEMI      &as DOT GREATER_THAN  &kp LCTRL     &kp RALT                 &trans
                                 &kp LGUI     &kp ESC              &kp SPACE       &kp RET       &trans                &kp TAB
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans  &studio_unlock
&trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans
                   &trans     &trans     &trans  &trans  &trans  &trans
            >;
        };

        colemak_layer {
            display-name = "Colemak";
            bindings = <
&kp Q          &kp W          &kp F           &kp P          &kp B        &kp J     &kp L          &kp U          &kp Y          &kp SEMI
&hml LGUI A    &hml LALT R    &hml LCTRL S    &hml LSHFT T   &kp G        &kp M     &hmr RSHFT N   &hmr RCTRL E   &hmr RALT I    &hmr RGUI O
&kp Z          &kp X          &kp C           &kp D          &kp V        &kp K     &kp H          &kp RCTRL      &kp RALT       &kp DOT
                              &lt 3 LEFT_GUI  &mo 1          &kp SPACE    &kp RET   &mo 2          &kp BSPC
            >;
        };
    };
};

// Auto-activate the mouse layer (3) while the right trackball moves, so the
// mouse buttons on that layer are available without holding a layer key.
// Keep the shield's report-rate-limit processor. Timeout in ms is tunable.
&trackball_central_listener {
    input-processors = <&zip_ble_report_rate_limit>, <&zip_temp_layer 3 250>;
};
